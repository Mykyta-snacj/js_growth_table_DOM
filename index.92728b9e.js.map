"use strict";
var container = document.querySelector(".container");
var field = document.querySelector(".field");
var tbody = field.querySelector("tbody");
// check actual size
var actualRowsLength = field.querySelector("tbody").children.length;
var actualColumnsLength = field.querySelector("tr").children.length;
container.addEventListener("click", function(e) {
    var row = field.querySelector("tr");
    if (e.target.closest(".append-row")) {
        var newRow = document.createElement("tr");
        for(var i = 0; i < actualColumnsLength; i++)newRow.append(row.children[i].cloneNode());
        if (actualRowsLength < 10) {
            tbody.append(newRow);
            actualRowsLength += 1;
        }
    }
    if (e.target.closest(".remove-row")) {
        if (actualRowsLength > 2) {
            row.remove();
            actualRowsLength -= 1;
        }
    }
    if (e.target.closest(".append-column")) {
        var newColumn = document.createElement("td");
        if (actualColumnsLength < 10) {
            actualColumnsLength += 1;
            for(var i1 = 0; i1 < actualRowsLength; i1++)tbody.children[i1].append(newColumn.cloneNode());
        }
    }
    if (e.target.closest(".remove-column")) {
        if (actualColumnsLength > 2) {
            actualColumnsLength -= 1;
            for(var i2 = 0; i2 < actualRowsLength; i2++)tbody.children[i2].querySelector("td").remove();
        }
    }
});

